/*
 * Family Assistance Alert — audio transport R1 (portal spec
 * family-assistance-alert.md §4.3 / D15): uart1 re-pinned from the nRF5340
 * connectivity bridge (P0.04 RX / P0.05 TX, 1 Mbaud dump channel) onto the
 * P1 expansion connector at 9600 baud for the DFR0534 MP3 module.
 *
 * Why uart1: the nRF9151 has no spare UARTE — uart2 shares its peripheral
 * slot with i2c2 (ADXL367 + nPM1300) and uart3 with spi3 (flash + BMI270).
 * The dump/BLE-NUS channel is bench-only and already unused in every
 * FIELD_MODE image, so it is the instance we can give up.
 *
 * Pin map (schematic PCA20065 v2.0.0, nRF9151 sheet, net labels on the GPIO
 * column):  EXP_BOARD_PIN1 = P0.19  (P1 pin 4, SCL side, SB8)
 *           EXP_BOARD_PIN2 = P0.18  (P1 pin 3, SDA side, SB9)
 * Both go through the TXS0102 level shifter (U24) to the 3.3 V P1 side.
 * SB8 and SB9 MUST BE CUT first — closed, they bridge these two GPIOs onto
 * the sensor I²C bus (SCL/SDA on P0.08/P0.09).
 *
 * With the SparkFun Qwiic→Gravity cable (Qwiic SDA→Gravity pin 1 = module "T",
 * Qwiic SCL→Gravity pin 2 = module "R"): our TX (P0.19) → module R, our RX
 * (P0.18) ← module T. If the bench meter says otherwise, swap the two psels
 * below — never the cable.
 *
 * Apply with:  -DEXTRA_DTC_OVERLAY_FILE=boards/assist_audio_uart1.overlay
 */

&pinctrl {
	uart1_assist_default: uart1_assist_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 19)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 0, 18)>;
			bias-pull-up;
		};
	};

	uart1_assist_sleep: uart1_assist_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 19)>,
				<NRF_PSEL(UART_RX, 0, 18)>;
			low-power-enable;
		};
	};
};

&uart1 {
	status = "okay";
	current-speed = <9600>;
	pinctrl-0 = <&uart1_assist_default>;
	pinctrl-1 = <&uart1_assist_sleep>;
	pinctrl-names = "default", "sleep";
};

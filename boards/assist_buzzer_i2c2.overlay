/*
 * Family Assistance Alert — SparkFun Qwiic Buzzer (BOB-24474) on the P1 Qwiic
 * connector of an UNMODIFIED Thingy:91 X (SB8/SB9 intact): P1 pins 3/4 are the
 * sensor I²C bus (i2c2, SDA P0.09 / SCL P0.08) through the TXS0102 level
 * shifter. Bus power for the buzzer board is VDD_EXP_BRD, switched by P0.03
 * (`exp_board_enable`) — the feedback layer powers it only during an incident.
 *
 * This is the production-representative wiring (spec family-assistance-alert.md
 * v0.4 §4). Apply with: -DEXTRA_DTC_OVERLAY_FILE=boards/assist_buzzer_i2c2.overlay
 */

&i2c2 {
	qwiic_buzzer: buzzer@34 {
		compatible = "sparkfun,qwiic-buzzer";
		reg = <0x34>;
		status = "okay";
	};
};

/* Bench experiment 2026-09-23: the Qwiic Buzzer's 2.2 k pull-ups to 3.3 V load
 * the 1.8 V sensor bus through the TXS0102. High-drive lows on the nRF9151
 * side (H0D1) recover the master's own low levels; the sensors' ACK lows
 * still need the buzzer's pull-up jumper cut. */
&i2c2_default {
	group1 {
		nordic,drive-mode = <NRF_DRIVE_H0D1>;
	};
};
&i2c2_sleep {
	group1 {
		nordic,drive-mode = <NRF_DRIVE_H0D1>;
	};
};
